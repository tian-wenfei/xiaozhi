+
+    // Sweat drop at the temple.
+    sweat_ = lv_obj_create(face_container_);
+    make_solid(sweat_, lv_color_black());
+    lv_obj_set_size(sweat_, 4, 6);
+    hide(sweat_);
+
+    // Floating hearts: two round lobes plus a diamond tip.
+    for (int h = 0; h < 2; h++) {
+        for (int l = 0; l < 2; l++) {
