+void OledDisplay::SetStatus(const char* status) {
+    LvglDisplay::SetStatus(status);
+
+    DisplayLockGuard lock(this);
+    const bool was_listening = listening_;
+    speaking_ = (status != nullptr && strcmp(status, Lang::Strings::SPEAKING) == 0);
+    listening_ = (status != nullptr && strcmp(status, Lang::Strings::LISTENING) == 0);
+    if (listening_ && !was_listening) {
+        // A new conversation starts: drop the lingering expression so the
+        // listening eyes are visible immediately.
+        emotion_hold_until_ = 0;
+        SetFace(Face::IDLE);
+    }
+    bool hold = false;
+    if (status != nullptr) {
+        hold = (strcmp(status, Lang::Strings::ACTIVATION) == 0 ||
+                strcmp(status, Lang::Strings::REGISTERING_NETWORK) == 0 ||
+                strcmp(status, Lang::Strings::WIFI_CONFIG_MODE) == 0);
+    }
+    status_hold_ = hold;
+    SetTextModeInternal(status_hold_ || notification_active_);
+}
+
+void OledDisplay::ShowNotification(const char* notification, int duration_ms) {
+    LvglDisplay::ShowNotification(notification, duration_ms);
+
+    DisplayLockGuard lock(this);
+    notification_active_ = true;
+    SetTextModeInternal(true);
+
+    if (eyes_timer_ != nullptr) {
+        lv_timer_del(eyes_timer_);
+        eyes_timer_ = nullptr;
+    }
+    int ms = duration_ms > 0 ? duration_ms : 3000;
+    eyes_timer_ = lv_timer_create(NotificationTimerCb, ms, this);
+    if (eyes_timer_ != nullptr) {
+        lv_timer_set_repeat_count(eyes_timer_, 1);
+    }
+}
+
+void OledDisplay::SetTextModeInternal(bool on) {
+    text_mode_ = on;
+    if (face_container_ != nullptr) {
+        if (on) {
+            lv_obj_add_flag(face_container_, LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_remove_flag(face_container_, LV_OBJ_FLAG_HIDDEN);
+            ApplyFacePose();
+            blink_at_ = tick_ + 40;
+        }
+    }
+    if (container_ != nullptr) {
+        if (on) {
+            lv_obj_remove_flag(container_, LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_add_flag(container_, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+    if (status_bar_ != nullptr) {
+        if (on) {
+            lv_obj_remove_flag(status_bar_, LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_add_flag(status_bar_, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+}
