+    lv_obj_set_scrollbar_mode(face_container_, LV_SCROLLBAR_MODE_OFF);
+
+    auto make_solid = [](lv_obj_t* obj, lv_color_t color) {
+        lv_obj_set_style_bg_color(obj, color, 0);
+        lv_obj_set_style_bg_opa(obj, LV_OPA_COVER, 0);
+        lv_obj_set_style_border_width(obj, 0, 0);
+        lv_obj_set_style_outline_width(obj, 0, 0);
+        lv_obj_set_style_shadow_width(obj, 0, 0);
+        lv_obj_set_style_pad_all(obj, 0, 0);
+        lv_obj_set_style_radius(obj, LV_RADIUS_CIRCLE, 0);
+        lv_obj_set_style_transform_pivot_x(obj, LV_PCT(50), 0);
+        lv_obj_set_style_transform_pivot_y(obj, LV_PCT(50), 0);
+        lv_obj_clear_flag(obj, LV_OBJ_FLAG_SCROLLABLE);
+    };
+
+    auto make_block = [](lv_obj_t* obj, lv_color_t color) {
+        lv_obj_set_style_bg_color(obj, color, 0);
+        lv_obj_set_style_bg_opa(obj, LV_OPA_COVER, 0);
+        lv_obj_set_style_border_width(obj, 0, 0);
+        lv_obj_set_style_outline_width(obj, 0, 0);
+        lv_obj_set_style_shadow_width(obj, 0, 0);
+        lv_obj_set_style_pad_all(obj, 0, 0);
+        lv_obj_set_style_radius(obj, 0, 0);
+        lv_obj_set_style_transform_pivot_x(obj, LV_PCT(50), 0);
+        lv_obj_set_style_transform_pivot_y(obj, LV_PCT(50), 0);
+        lv_obj_clear_flag(obj, LV_OBJ_FLAG_SCROLLABLE);
+    };
+
+    auto hide = [](lv_obj_t* obj) { lv_obj_add_flag(obj, LV_OBJ_FLAG_HIDDEN); };
+
+    // The panel lights up dark LVGL pixels: black features glow on the screen.
+    eye_left_ = lv_obj_create(face_container_);
+    eye_right_ = lv_obj_create(face_container_);
+    make_solid(eye_left_, lv_color_black());
+    make_solid(eye_right_, lv_color_black());
+
+    // Smile eyes: explicit "^" polylines, clearer than a tilted bar.
+    smile_l_ = lv_line_create(face_container_);
+    smile_r_ = lv_line_create(face_container_);
+    for (int i = 0; i < 2; i++) {
+        lv_obj_t* line = (i == 0) ? smile_l_ : smile_r_;
+        lv_obj_set_style_bg_opa(line, LV_OPA_TRANSP, 0);
+        lv_obj_set_style_border_width(line, 0, 0);
+        lv_obj_set_style_pad_all(line, 0, 0);
+        lv_obj_set_style_line_width(line, 3, 0);
+        lv_obj_set_style_line_rounded(line, true, 0);
+        lv_obj_set_style_line_color(line, lv_color_black(), 0);
+        hide(line);
+    }
+
+    // Eyebrows: short bars above the eyes, tilted per expression.
+    brow_left_ = lv_obj_create(face_container_);
+    brow_right_ = lv_obj_create(face_container_);
+    make_solid(brow_left_, lv_color_black());
+    make_solid(brow_right_, lv_color_black());
+    lv_obj_set_size(brow_left_, 11, 2);
+    lv_obj_set_size(brow_right_, 11, 2);
+    hide(brow_left_);
+    hide(brow_right_);
+
+    // Blush: two small dots on the cheeks.
+    blush_left_ = lv_obj_create(face_container_);
+    blush_right_ = lv_obj_create(face_container_);
+    make_solid(blush_left_, lv_color_black());
+    make_solid(blush_right_, lv_color_black());
+    lv_obj_set_size(blush_left_, 5, 5);
+    lv_obj_set_size(blush_right_, 5, 5);
+    hide(blush_left_);
+    hide(blush_right_);
+
+    // Tears: two drops per side for a full stream.
+    lv_obj_t* tears[4] = {nullptr, nullptr, nullptr, nullptr};
+    lv_obj_t** tear_slots[4] = {&tear_left_, &tear_left2_, &tear_right_, &tear_right2_};
+    for (int i = 0; i < 4; i++) {
+        tears[i] = lv_obj_create(face_container_);
+        make_solid(tears[i], lv_color_black());
+        lv_obj_set_size(tears[i], 3, 4);
+        hide(tears[i]);
+        *tear_slots[i] = tears[i];
